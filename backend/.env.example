# Copy to .env for local backend development. Do not commit the copied file.
DATABASE_URL=postgresql+psycopg://portero:replace-with-a-local-database-password@localhost:5432/portero
# Consumed by pytest/verify.ps1, never by the application. The database must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://portero:replace-with-a-local-database-password@localhost:5432/portero_test
APP_ENV=development
APP_SECRET_KEY=replace-with-a-random-secret
DEVICE_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
MEDIA_ROOT=../media
FRONTEND_ORIGIN=http://localhost:3000
DEVICE_HEARTBEAT_INTERVAL=15
DEVICE_OFFLINE_TIMEOUT=45
COMMAND_TIMEOUT_SECONDS=30
SESSION_TTL_SECONDS=28800
MAX_UPLOAD_BYTES=5242880

# Optional integrations and cookie policy
OPENAI_API_KEY=sk-example-not-a-real-key
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
CONVERSATION_MAX_SECONDS=300
CONVERSATION_IDLE_SECONDS=45
AUDIO_INPUT_QUEUE_FRAMES=50
AUDIO_OUTPUT_QUEUE_FRAMES=100
OPENAI_REALTIME_SMOKE=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_PATH=/
MAX_WEBSOCKET_MESSAGE_BYTES=262144

# Bootstrap is intentionally opt-in; it rejects this placeholder and blank values.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.test
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-bootstrap-password

# Generate local secrets with PowerShell (do not paste them into source control):
# $rng = [Security.Cryptography.RandomNumberGenerator]::Create(); $bytes = New-Object byte[] 48; $rng.GetBytes($bytes); [Convert]::ToBase64String($bytes); $rng.Dispose()
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
