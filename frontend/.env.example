# Copy to .env.local. Server-side only: never put credentials in NEXT_PUBLIC_* variables.
# Next proxies browser /api requests here to preserve the HttpOnly session cookie.
BACKEND_ORIGIN=http://localhost:8000
# Set only when intentionally calling a separately hosted public API (for example, a trusted same-site deployment).
# NEXT_PUBLIC_API_URL=https://api.example.com

# Device simulator WebSocket endpoint (public URL only; never include a device secret).
# Required in production; development defaults to ws://localhost:8000/ws/device.
NEXT_PUBLIC_DEVICE_WS_URL=ws://localhost:8000/ws/device
